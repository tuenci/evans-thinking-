        }
      ]
    },
    {
      "num": 5,
      "badge": "CHAPTER 5",
      "title_zh": "四、怎样方能得重生？",
      "title_en": "How Can One Be Born Again?",
      "audioUrl": "audio/cszy/ch5.mp3",
